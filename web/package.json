{
  "name": "mezquita-pdf-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mezquita PDF: visor, editor y firmador de PDF como aplicación web instalable (PWA)",
  "scripts": {
    "predev": "node scripts/copiar-pdfjs.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copiar-pdfjs.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "iconos": "sh scripts/generar_iconos.sh",
    "prueba:firma": "tsx pruebas/prueba-firma.ts",
    "prueba:interfaz": "node pruebas/prueba-interfaz.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@fontsource/allura": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
